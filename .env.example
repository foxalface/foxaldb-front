# Frontend browser-facing URLs for local / LAN QA.
#
# When using Docker Compose, these are injected from the root DEV_HOST
# (see ../.env.example). You normally do not need this file in Docker.
#
# For non-Docker `npm run dev`, copy to .env.local and adjust:
#   cp .env.example .env.local
#
# localhost mode:
VITE_API_BASE_URL=http://localhost:8000/api
VITE_BACKEND_URL=http://localhost:8000
VITE_REVERB_APP_KEY=foxaldb-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
VITE_HMR_HOST=localhost
#
# LAN QA: replace localhost with the Mac LAN IP (never commit a personal IP).
# VITE_API_BASE_URL=http://192.168.x.x:8000/api
# VITE_BACKEND_URL=http://192.168.x.x:8000
# VITE_REVERB_HOST=192.168.x.x
# VITE_HMR_HOST=192.168.x.x
